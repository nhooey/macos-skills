# Nix build outputs
/result
/result-*
/skills/*/result
/skills/*/result-*

# skill-creator scratch workspaces (benchmarks, logs, eval outputs)
/skills/*-workspace/

# Git worktrees per the using-git-worktrees skill
/.worktrees/

# Project-scope skill installs from `nix develop`'s startup hooks; the
# skills' preferences files beside them are the project's own.
/.agents/skills/*
!/.agents/skills/*.preferences.md
/.claude/skills/

